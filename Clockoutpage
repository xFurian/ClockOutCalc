<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clock-Out Time Calculator | ProtonCube</title>
  <style>
    :root {
      --surface: #ffffff;
      --text: #172033;
      --muted: #5d6b82;
      --primary: #1f5eff;
      --primary-dark: #1647c7;
      --border: #d9e2f2;
      --shadow: 0 24px 60px rgba(23, 32, 51, .14);
      --radius: 22px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Inter, Segoe UI, Arial, sans-serif;
      background: radial-gradient(circle at top left, #dbe8ff, transparent 34%), linear-gradient(135deg, #f7faff 0%, #eef3fb 100%);
      color: var(--text);
      min-height: 100vh;
    }

    body.dark {
      --surface: #1f2937;
      --text: #f9fafb;
      --muted: #cbd5e1;
      --primary: #7aa2ff;
      --primary-dark: #9bb9ff;
      --border: #374151;
      background: linear-gradient(135deg, #0b1120, #111827);
    }

    .page {
      width: min(1120px, 92vw);
      margin: 0 auto;
      padding: 48px 0;
    }

    .hero {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 36px;
      align-items: center;
    }

    .hero-actions,
    .quick-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 18px 0;
    }

    .eyebrow {
      display: inline-flex;
      padding: 8px 12px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: rgba(255, 255, 255, .72);
      color: var(--muted);
      font-size: 14px;
      font-weight: 700;
    }

    h1 {
      font-size: clamp(42px, 6vw, 72px);
      line-height: .95;
      margin: 22px 0 18px;
      letter-spacing: -2px;
    }

    .lead {
      font-size: 20px;
      line-height: 1.65;
      color: var(--muted);
      max-width: 670px;
    }

    .btn {
      border: 0;
      border-radius: 14px;
      padding: 14px 18px;
      font-weight: 800;
      font-size: 15px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
    }

    .btn-secondary {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .card {
      background: rgba(255, 255, 255, .82);
      backdrop-filter: blur(18px);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    body.dark .card {
      background: rgba(31, 41, 55, .88);
    }

    .calculator {
      padding: 28px;
    }

    .calculator-header {
      margin-bottom: 16px;
    }

    .field {
      margin: 16px 0;
    }

    .field label,
    .settings label {
      display: block;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .field input {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--surface);
      color: var(--text);
      font-size: 16px;
    }

    .settings {
      display: block;
      margin: 16px 0 20px;
      padding: 16px;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, .52);
    }

    .settings strong {
      display: block;
      margin-bottom: 12px;
    }

    .summary {
      color: var(--muted);
      font-size: 14px;
      text-align: center;
    }

    .result {
      margin-top: 18px;
      padding: 18px;
      border-radius: 16px;
      background: #edf4ff;
      color: #0f326d;
      font-size: 18px;
      font-weight: 900;
      text-align: center;
    }

    body.dark .result {
      background: #172554;
      color: #dbeafe;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 38px;
    }

    .feature {
      padding: 22px;
    }

    .feature p {
      color: var(--muted);
    }

    .footer {
      margin-top: 38px;
      text-align: center;
      color: var(--muted);
      font-size: 14px;
    }

    @media (max-width: 860px) {
      .hero {
        grid-template-columns: 1fr;
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <main class="page">
    <section class="hero">
      <div>
        <span class="eyebrow">Simple schedule planning, built for daily use</span>
        <h1>Know exactly when your workday ends.</h1>
        <p class="lead">Calculate your clock-out time from your start time, lunch duration, and workday length. Built for quick daily use with saved preferences and a clean, focused layout.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#calculator">Calculate clock-out time</a>
          <a class="btn btn-secondary" href="https://www.protoncube.com/solitaire.html">Open Solitaire</a>
        </div>
      </div>

      <section class="card calculator" id="calculator" aria-label="Clock-out time calculator">
        <div class="calculator-header">
          <div>
            <h2>Clock-Out Calculator</h2>
            <p>Plan your day in seconds.</p>
          </div>
        </div>

        <div class="settings open" id="settingsModal">
          <strong>Preferences</strong>
          <label><input type="checkbox" id="darkMode"> Dark mode</label>
          <label><input type="checkbox" id="customHours"> Custom work hours</label>
          <label><input type="checkbox" id="use24Hour"> 24-hour result format</label>
        </div>

        <div class="quick-actions">
          <button class="btn btn-secondary" id="useCurrentTime" type="button">Use current time</button>
          <button class="btn btn-secondary" id="resetCalculator" type="button">Reset calculator</button>
        </div>

        <div class="field">
          <label for="clockIn">Clock-in time</label>
          <input type="time" id="clockIn" required>
        </div>

        <div class="field">
          <label for="lunch">Lunch duration, in minutes</label>
          <input type="number" id="lunch" value="30" min="0" step="5">
        </div>

        <div class="field" id="workHoursField">
          <label for="workHours">Workday length, in hours</label>
          <input type="number" id="workHours" value="8" min="1" max="24" step="0.5">
        </div>

        <button class="btn btn-primary" id="calculateButton" type="button">Calculate time</button>

        <div class="result" id="result" role="status" aria-live="polite">Enter a start time to calculate your clock-out target.</div>
        <p class="summary" id="summaryText">Current schedule: 8 work hours with a 30-minute lunch.</p>
      </section>
    </section>

    <section class="feature-grid" aria-label="Key benefits">
      <article class="card feature">
        <h3>Fast answer</h3>
        <p>Get the exact clock-out target without manual math or repeated time conversions.</p>
      </article>

      <article class="card feature">
        <h3>No hidden controls</h3>
        <p>Preferences are visible by default, making the page more reliable and easier to use.</p>
      </article>

      <article class="card feature">
        <h3>Cleaner workflow</h3>
        <p>Use current time, reset quickly, and press Enter to calculate without extra clicks.</p>
      </article>
    </section>

    <p class="footer">Hosted on GitHub. Built by Aaron Draheim.</p>
  </main>
<script>
  const darkModeToggle = document.getElementById("darkMode");
  const customHoursToggle = document.getElementById("customHours");
  const use24HourToggle = document.getElementById("use24Hour");
  const workHoursField = document.getElementById("workHoursField");
  const clockInInput = document.getElementById("clockIn");
  const lunchInput = document.getElementById("lunch");
  const workHoursInput = document.getElementById("workHours");
  const calculateButton = document.getElementById("calculateButton");
  const useCurrentTimeButton = document.getElementById("useCurrentTime");
  const resetCalculatorButton = document.getElementById("resetCalculator");
  const result = document.getElementById("result");
  const summaryText = document.getElementById("summaryText");

  function loadPreferences() {
    darkModeToggle.checked = localStorage.getItem("darkMode") === "true";
    customHoursToggle.checked = localStorage.getItem("customHours") === "true";
    use24HourToggle.checked = localStorage.getItem("use24Hour") === "true";
    document.body.classList.toggle("dark", darkModeToggle.checked);
    workHoursField.style.display = customHoursToggle.checked ? "block" : "none";
    updateSummary();
  }

  function savePreferences() {
    localStorage.setItem("darkMode", darkModeToggle.checked);
    localStorage.setItem("customHours", customHoursToggle.checked);
    localStorage.setItem("use24Hour", use24HourToggle.checked);
    loadPreferences();
  }

  function updateSummary() {
    const lunch = parseInt(lunchInput.value, 10) || 0;
    const workHours = customHoursToggle.checked ? parseFloat(workHoursInput.value) || 8 : 8;
    summaryText.textContent = `Current schedule: ${workHours} work hours with a ${lunch}-minute lunch.`;
  }

  function formatTime(date) {
    let hours = date.getHours();
    const minutes = String(date.getMinutes()).padStart(2, "0");

    if (use24HourToggle.checked) {
      return `${String(hours).padStart(2, "0")}:${minutes}`;
    }

    const ampm = hours >= 12 ? "PM" : "AM";
    hours = hours % 12 || 12;

    return `${hours}:${minutes} ${ampm}`;
  }

  function calculateClockOut() {
    const clockIn = clockInInput.value;
    const lunch = parseInt(lunchInput.value, 10);
    const workHours = customHoursToggle.checked ? parseFloat(workHoursInput.value) : 8;

    if (!clockIn) {
      result.textContent = "Please enter a valid clock-in time first.";
      return;
    }

    if (Number.isNaN(lunch) || lunch < 0) {
      result.textContent = "Lunch duration must be zero minutes or greater.";
      return;
    }

    if (Number.isNaN(workHours) || workHours <= 0 || workHours > 24) {
      result.textContent = "Workday length must be between 1 and 24 hours.";
      return;
    }

    const [hours, minutes] = clockIn.split(":").map(Number);
    const startDate = new Date();
    startDate.setHours(hours, minutes, 0, 0);

    const totalMinutes = (workHours * 60) + lunch;
    const endDate = new Date(startDate.getTime() + totalMinutes * 60000);

    result.textContent = `Your target clock-out time is ${formatTime(endDate)}.`;
    updateSummary();
  }

  function useCurrentTime() {
    const now = new Date();
    clockInInput.value = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;
    calculateClockOut();
  }

  function resetCalculator() {
    clockInInput.value = "";
    lunchInput.value = "30";
    workHoursInput.value = "8";
    result.textContent = "Enter a start time to calculate your clock-out target.";
    updateSummary();
  }

  calculateButton.addEventListener("click", calculateClockOut);
  useCurrentTimeButton.addEventListener("click", useCurrentTime);
  resetCalculatorButton.addEventListener("click", resetCalculator);

  darkModeToggle.addEventListener("change", savePreferences);
  customHoursToggle.addEventListener("change", savePreferences);
  use24HourToggle.addEventListener("change", savePreferences);

  clockInInput.addEventListener("input", updateSummary);
  lunchInput.addEventListener("input", updateSummary);
  workHoursInput.addEventListener("input", updateSummary);

  [clockInInput, lunchInput, workHoursInput].forEach(function (input) {
    input.addEventListener("keydown", function (event) {
      if (event.key === "Enter") {
        calculateClockOut();
      }
    });
  });

  loadPreferences();
</script>
</body>
</html>

